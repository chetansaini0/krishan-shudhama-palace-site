generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  failed
}

enum InquiryStatus {
  new
  quoted
  won
  lost
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  phone        String?
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

model Room {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  category          String
  tagline           String
  description       String
  images            String[]
  amenities         String[]
  basePrice         Int
  weekendMultiplier Float
  maxGuests         Int
  sizeSqFt          Int?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
}

model Booking {
  id               String        @id @default(cuid())
  roomSlug         String
  guestName        String
  email            String
  phone            String
  checkIn          DateTime
  checkOut         DateTime
  guests           Int
  nights           Int
  totalAmount      Int
  currency         String        @default("INR")
  status           BookingStatus @default(pending)
  razorpayOrderId  String?
  razorpayPaymentId String?
  userId           String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
  room Room? @relation(fields: [roomSlug], references: [slug])

  @@index([roomSlug, checkIn, checkOut])
  @@index([email])
  @@index([status])
}

model Offer {
  id              String   @id @default(cuid())
  title           String
  description     String
  code            String   @unique
  discountPercent Int
  validUntil      DateTime
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventInquiry {
  id          String       @id @default(cuid())
  name        String
  email       String
  phone       String
  eventType   String
  guestCount  Int
  eventDate   DateTime?
  message     String
  status      InquiryStatus @default(new)
  adminNotes  String?
  quotedAmount Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  source    String   @default("website")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
